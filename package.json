{
  "name": "dsh-plugin-template",
  "version": "0.1.0",
  "description": "Dual-side (host + client) DeepSeek Harness plugin template with Typert Remote, React view, tests, lint, and CI.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run check"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/dsh-typert-registry": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-api-remotes": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-alpha.3",
    "@deepseek-ai/schemastery": "3.18.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.3",
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-alpha.3"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bugmaker2/dsh-plugin-template.git"
  },
  "bugs": {
    "url": "https://github.com/bugmaker2/dsh-plugin-template/issues"
  },
  "homepage": "https://github.com/bugmaker2/dsh-plugin-template",
  "author": {
    "name": "bugmaker2",
    "url": "https://github.com/bugmaker2"
  }
}
